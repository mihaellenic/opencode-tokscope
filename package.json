    "@opencode/client": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/keymap": "0.6.6",
    "@opentui/solid": "0.6.6",
    "solid-js": "1.9.15",
    "typescript": "5.7.3",
    "@types/bun": "1.4.0"
  }
